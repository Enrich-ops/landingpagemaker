# --- Required ---
OPENAI_API_KEY=            # Whisper transcription (word-level timestamps)
ANTHROPIC_API_KEY=         # Claude picks the viral moments

# --- Server ---
PORT=3000
PUBLIC_URL=http://localhost:3000   # must match the redirect URIs registered below
APP_PASSWORD=                      # set this if you expose the app beyond localhost (HTTP basic auth, any username)

# --- Clip settings ---
CLIP_MODEL=claude-sonnet-5-5
CLIP_MIN_SECONDS=20
CLIP_MAX_SECONDS=60
CLIPS_PER_VIDEO=8

# --- TikTok (developers.tiktok.com -> Content Posting API; scopes video.upload, video.publish) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# redirect URI to register: ${PUBLIC_URL}/auth/tiktok/callback

# --- YouTube (Google Cloud -> YouTube Data API v3, OAuth client type "Web application") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_CHANNEL_ID=UCLHIpELaHyVsSaQPJnL0n3w   # only this channel can be connected
# redirect URI to register: ${PUBLIC_URL}/auth/youtube/callback

# --- Auto-post ---
AUTO_POST_MIN_SCORE=80     # only clips scored >= this are auto-posted
POST_INTERVAL_MINUTES=180  # spacing between auto-posted clips
